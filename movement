-- ==========================================
-- MOVEMENT & JUMP LOGIC
-- ==========================================
local function startCFrameSpeed()
	Connection = RunService.RenderStepped:Connect(function(dt)
		local character = Player.Character
		if not character then return end

		local rootPart = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not rootPart or not humanoid then return end

		if humanoid.MoveDirection.Magnitude > 0 then
			local moveVector = Vector3.new(humanoid.MoveDirection.X, 0, humanoid.MoveDirection.Z).Unit
			rootPart.CFrame = rootPart.CFrame + (moveVector * (CurrentSpeed * dt))
		end
	end)
end

local function stopCFrameSpeed()
	if Connection then
		Connection:Disconnect()
		Connection = nil
	end
end

local function toggleSpeed()
	Enabled = not Enabled
	if Enabled then
		startCFrameSpeed()
		ToggleButton.Text = "Speed: ON"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		stopCFrameSpeed()
		ToggleButton.Text = "Speed: OFF"
		ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end

local function toggleInfiniteJump()
	InfiniteJumpEnabled = not InfiniteJumpEnabled
	if InfiniteJumpEnabled then
		JumpToggleButton.Text = "InfJump: ON"
		JumpToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		JumpToggleButton.Text = "InfJump: OFF"
		JumpToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end
end

-- ==========================================
-- EVENT LISTENERS
-- ==========================================
SpeedBox.FocusLost:Connect(function(enterPressed)
	local num = tonumber(SpeedBox.Text)
	if num then
		CurrentSpeed = math.max(0, num)
		SpeedBox.Text = tostring(CurrentSpeed)
	else
		SpeedBox.Text = tostring(CurrentSpeed)
	end
end)

ToggleButton.MouseButton1Click:Connect(toggleSpeed)
JumpToggleButton.MouseButton1Click:Connect(toggleInfiniteJump)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	
	-- Handle Infinite Jump (Only triggers once per spacebar press)
	if input.KeyCode == Enum.KeyCode.Space and InfiniteJumpEnabled then
		local character = Player.Character
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
		
	-- Toggle speed with 'C'
	elseif input.KeyCode == Enum.KeyCode.C then
		toggleSpeed()
		
	-- Toggle UI visibility with 'Right Control'
	elseif input.KeyCode == Enum.KeyCode.RightControl then
		MainFrame.Visible = not MainFrame.Visible
	end
end)
